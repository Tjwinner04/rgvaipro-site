# Copy to `.env.local` (do not commit `.env.local`).

# n8n Webhook URL — preferred (server-only).
N8N_CONTACT_WEBHOOK_URL=

# Optional: same URL for dev / client “configured” banner.
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK_URL=

# Header / footer: phone (display + tap-to-call), email override, social profile URLs.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
